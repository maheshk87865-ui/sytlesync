{
  "name": "stylesync-salon-backend",
  "version": "0.1.0",
  "private": true,
  "description": "StyleSync Salon Partner App — Backend API",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "NODE_ENV=production bun src/server.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push --accept-data-loss",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "bun run src/scripts/seed.ts",
    "test": "bun run src/scripts/security-test.ts && bun run src/scripts/booking-concurrency-test.ts && bun run src/scripts/consistency-test.ts",
    "test:security": "bun run src/scripts/security-test.ts",
    "test:concurrency": "bun run src/scripts/booking-concurrency-test.ts",
    "test:consistency": "bun run src/scripts/consistency-test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "uuid": "^10.0.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.0.0",
    "prisma": "^6.11.1",
    "typescript": "^5.5.4"
  }
}
