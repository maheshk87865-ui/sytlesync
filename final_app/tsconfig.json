{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@prisma/client-admin1": ["./generated-clients/admin1"],
      "@prisma/client-admin": ["./generated-clients/admin"]
    },
    "types": ["node"]
  },
  "include": ["sync-authoritative-db.ts", "run-e2e-integration-suite.ts", "api-client.ts"]
}
